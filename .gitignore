# --- Secrets -----------------------------------------------------------------
# The real master key K is never committed (CLAUDE.md 0.3). Demo keys only,
# clearly labelled, live elsewhere.
secrets/*
!secrets/.gitkeep

# --- Datasets ----------------------------------------------------------------
# Leading slash matters: a bare `data/` also matches src/data/, which is source
# code, and silently kept the CIFAR-10 pipeline out of the repo.
/data/

# --- Notebook scratch --------------------------------------------------------
# 00_setup.ipynb writes here when run outside Colab, standing in for Drive.
_local_drive/

# --- Model weights and checkpoints -------------------------------------------
*.pth
*.pt
*.ckpt
# Checkpoints live on Drive during a GPU run; a local copy is scratch.
checkpoints/

# --- Zero-knowledge artifacts (large binaries) -------------------------------
*.ptau
*.zkey
*.r1cs
*.wtns
*.sym

# --- Colab handoff packages --------------------------------------------------
handoff/*.zip

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Track A toolchain (P7.2), reproduced by zk/README.md ---------------------
/tools/bin/
/zk/node_modules/
# Public powers-of-tau files (P7.4), hash-checked on use
/zk/ptau/
# Groth16 proving keys (P7.6); the verification key is committed under results/zk/
/zk/keys/
